{
  "name": "vLLM ROCm Nightly",
  "image": "vllm/vllm-openai-rocm:nightly",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "uid": "automatic",
      "gid": "automatic",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    }
  },
  "workspaceFolder": "/workspace/vllm",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/vllm,type=bind,consistency=cached",
  "initializeCommand": "mkdir -p /home/naqin/vllm/.tmp /home/naqin/.cache/vllm /home/naqin/.cache/torch /apps/naqin/huggingface",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "userEnvProbe": "loginInteractiveShell",
  "overrideCommand": true,
  "runArgs": [
    "--entrypoint",
    "",
    "--group-add=video",
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--device",
    "/dev/kfd",
    "--device",
    "/dev/dri",
    "--network=host",
    "--ipc=host"
  ],
  "containerEnv": {
    "HOME": "/home/vscode",
    "HF_HOME": "/home/vscode/.cache/huggingface",
    "HUGGING_FACE_HUB_TOKEN": "${localEnv:HF_TOKEN}",
    "HF_TOKEN": "${localEnv:HF_TOKEN}",
    "PYTHONPATH": "/workspace/vllm",
    "PYTORCH_ROCM_ARCH": "gfx942",
    "TMPDIR": "/tmp",
    "VLLM_TARGET_DEVICE": "rocm",
    "VLLM_ROCM_USE_AITER": "1",
    "VLLM_ROCM_SHUFFLE_KV_CACHE_LAYOUT": "False",
    "VLLM_USE_PRECOMPILED": "1",
    "VLLM_CACHE_ROOT": "/tmp/vllm-cache"
  },
  "remoteEnv": {
    "HOME": "/home/vscode",
    "SHELL": "/bin/bash"
  },
  "mounts": [
    "source=/apps,target=/apps,type=bind,consistency=cached",
    "source=/apps/naqin/huggingface,target=/home/vscode/.cache/huggingface,type=bind,consistency=cached",
    "source=/home/naqin/.cache/vllm,target=/home/vscode/.cache/vllm,type=bind,consistency=cached",
    "source=/home/naqin/.cache/torch,target=/home/vscode/.cache/torch,type=bind,consistency=cached",
    "source=/home/naqin/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
    "source=/home/naqin/.gitconfig,target=/home/vscode/.gitconfig.host,type=bind,readonly",
    "source=/home/naqin/.gitignore,target=/home/vscode/.gitignore_global,type=bind,readonly"
  ],
  "postCreateCommand": "mkdir -p /workspace/vllm/.tmp /home/vscode/.cache/huggingface /home/vscode/.cache/vllm /home/vscode/.cache/torch && cp /home/vscode/.gitconfig.host /home/vscode/.gitconfig && git config --global core.excludesfile /home/vscode/.gitignore_global && git config --global --add safe.directory /workspace/vllm && (HOME=/workspace/vllm TMPDIR=/workspace/vllm/.tmp VLLM_TARGET_DEVICE=rocm VLLM_USE_PRECOMPILED=1 PYTHONPATH=/workspace/vllm /usr/bin/python setup.py build_ext --inplace; test -e /workspace/vllm/vllm/_C*.so -a -e /workspace/vllm/vllm/_rocm_C*.so) || HOME=/workspace/vllm TMPDIR=/workspace/vllm/.tmp VLLM_TARGET_DEVICE=rocm VLLM_USE_PRECOMPILED=0 PYTHONPATH=/workspace/vllm /usr/bin/python setup.py build_ext --inplace",
  "postAttachCommand": "git status --short --branch",
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
